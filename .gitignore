# 本地配置与敏感信息（.env.<API_ENV> 同样不入库；.env.example 模板除外）
.env
.env.*
!.env.example
*.log

# Python 缓存与打包产物
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
build/
dist/
*.egg-info/

# 报告产物（每次运行生成，不入库；预览图保留）
reports/*.html
reports/failed_requests/
reports/.cleanup_*.json
reports/archive/
reports/junit.xml
reports/run_summary.json
reports/api_coverage.md
reports/api_coverage.json
reports/.api_coverage_*.json
reports/known_defects.md
reports/xfail_manifest.json
reports/*_xfail_manifest.json
reports/.xfail_manifest_*.json

# 编辑器与工具本地状态
.idea/
.vscode/
*.swp
.ruff_cache/
.workbuddy/
