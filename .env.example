# 复制本文件为 .env 后按需修改；.env 不提交版本库。
# 优先级：进程环境变量 > .env.<API_ENV> > .env > config.py 默认值。
# 通用说明：默认执行项目由 pytest.ini 的 testpaths 决定；run.bat 可用 API_PROJECT 切换。
# 新增系统：python -m framework.scaffold 项目名 --base-url http://host --prefix 前缀_

# ===== 运行环境（多环境）=====
# 设置 API_ENV=test 后，框架先加载 .env.test（优先），再加载 .env 兜底：
# 环境差异只维护差异项，公共项留在 .env。API_ENV 必须在进程启动前设置。
# API_ENV=test
# 报告按时间戳归档到 reports/archive/，保留最近 N 份（0 关闭归档）
# API_REPORT_KEEP=30

# ===== 鉴权通配：所有项目都可用 <前缀>AUTH_* 配置，无需改 Python 代码 =====
# <前缀>AUTH_MODE=bearer          # bearer / header / cookie / auto / none
# <前缀>AUTH_LOGIN_PATH=/api/auth/login
# <前缀>AUTH_USERNAME_FIELD=username
# <前缀>AUTH_PASSWORD_FIELD=password
# <前缀>AUTH_TOKEN_FIELD=token    # 或 AUTH_TOKEN_PATH=data.access_token
# <前缀>AUTH_HEADER=Authorization
# <前缀>AUTH_SCHEME=Bearer
# <前缀>AUTH_COOKIE_NAME=

# ===== 请求层：重试仅用于 GET/HEAD/OPTIONS/PUT/DELETE 与 HTTP 429/5xx，业务 code 失败不重试 =====
# API_RETRY_ENABLED=1              # 0 关闭重试
# API_MAX_RETRIES=1                # 额外重试次数
# API_RETRY_BACKOFF=0.2            # 退避基数（秒），第 n 次等待 n*backoff
# API_RETRY_STATUSES=429,500,502,503,504
# API_TRACE_ENABLED=1              # 每次请求生成链路 ID 并注入请求头
# API_TRACE_HEADER=X-Trace-Id

# ===== 敏感信息脱敏 =====
# 报告与失败存档中按「键名」脱敏的 JSON 字段（请求体 / 响应体 / query），
# 逗号分隔；设置后完全替换默认清单（password,passwd,pwd,secret,token,access_token,refresh_token,session_id,authorization,credit_card,id_card）
# API_SENSITIVE_KEYS=password,token

# ===== 以下为 shopping 项目配置（前缀 SHOPPING_）=====
# 被测后端地址（Spring Boot，不是 Vite 的 5173）
SHOPPING_API_BASE_URL=http://127.0.0.1:8080
SHOPPING_API_TIMEOUT=10

# 商城演示账号（与 sql/data.sql 一致）
SHOPPING_STORE_USER=demo
SHOPPING_STORE_PASSWORD=123456

# 用户端鉴权（shopping 已用 AuthSpec 接入，下面值是默认值，可改）
SHOPPING_AUTH_MODE=bearer
SHOPPING_AUTH_LOGIN_PATH=/api/auth/login
SHOPPING_AUTH_TOKEN_PATH=data.token

# 管理端鉴权（独立前缀，登录路径与用户端不同）
SHOPPING_ADMIN_AUTH_LOGIN_PATH=/api/admin/auth/login
SHOPPING_ADMIN_USER=admin
SHOPPING_ADMIN_PASSWORD=admin123
SHOPPING_REVIEWER_USER=reviewer
SHOPPING_REVIEWER_PASSWORD=review123
SHOPPING_OPERATOR_USER=operator
SHOPPING_OPERATOR_PASSWORD=op123456

# 用于提交商品申请的分类 ID 与默认图片
SHOPPING_CATEGORY_ID=1

# 数据库清理与落库断言（PyMySQL 驱动直连，不再依赖 mysql.exe）
SHOPPING_MYSQL_HOST=localhost
SHOPPING_MYSQL_PORT=3306
SHOPPING_MYSQL_DATABASE=shopping_db
SHOPPING_MYSQL_USER=root
SHOPPING_MYSQL_PASSWORD=123456
# 数据库不可用时的策略：1=硬失败（CI 建议，设 CI=true 环境变量时自动生效），0=跳过落库断言（本地）
# SHOPPING_DB_STRICT=0

# 上传文件落盘目录（必填，无默认值；缺失时启动即报错并列出缺项）
SHOPPING_UPLOAD_DIR=D:\shopping\backend\uploads\images
